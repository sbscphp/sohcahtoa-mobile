{
  "expo": {
    "name": "sohcahtoa",
    "slug": "sohcahtoa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-centered-square.png",
    "scheme": "sohcahtoa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.iamkennis.sohcahtoa",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allows $(PRODUCT_NAME) to use Face ID for secure login.",
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": true,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "EXExpoAppSceneDelegate"
              }
            ]
          }
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/logo-centered-square.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.iamkennis.sohcahtoa",
      "allowBackup": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "@rnrepo/expo-config-plugin",
      "./plugins/withIosDeploymentTargetFix",
      "./plugins/withIPhoneDuoSceneDelegate",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/s-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-font",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allows $(PRODUCT_NAME) to use Face ID for secure login."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "873973f2-099b-440f-abd1-99c46a171491"
      }
    }
  }
}
