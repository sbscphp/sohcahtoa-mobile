{
  "expo": {
    "name": "sohcahtoa",
    "slug": "sohcahtoa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/s-logo.png",
    "scheme": "sohcahtoa",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/s-logo.png",
        "backgroundImage": "./assets/images/s-logo.png",
        "monochromeImage": "./assets/images/s-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.iamkennis.sohcahtoa"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 300,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "873973f2-099b-440f-abd1-99c46a171491"
      }
    }
  }
}
